---
// Video: muted, playsinline, loop, preload="metadata", poster z brag.jpg. Spouští se, až je vidět (site.ts),
// mimo obraz se pozastaví. Tlačítka: přehrát/pozastavit a zvuk (zapnutí zvuku ztlumí ostatní videa).
// mobileSrc = menší verze pro úzké displeje (scripts/optimize-videos.sh).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  src: string; mobileSrc?: string; poster: ImageMetadata; label: string; description: string;
  vertical?: boolean; class?: string; id?: string;
}
const { src, mobileSrc, poster, label, description, vertical = false, class: cls, id } = Astro.props;
const p = await getImage({ src: poster, width: vertical ? 540 : 1280, format: 'webp', quality: 78 });
const descId = `${id ?? src.replace(/\W+/g, '-')}-desc`;
---
<figure class:list={['player', { vertical }, cls]} id={id}>
  <video
    src={mobileSrc ? undefined : src} poster={p.src} width={p.attributes.width} height={p.attributes.height}
    muted playsinline loop preload="metadata" data-autoplay
    aria-label={label} aria-describedby={descId}
  >{mobileSrc && <source src={mobileSrc} media="(max-width: 700px)" type="video/mp4" />}{mobileSrc && <source src={src} type="video/mp4" />}</video>
  <p class="sr" id={descId}>{description}</p>
  <button type="button" class="big-play" data-act="play" aria-label="Přehrát video" tabindex="-1"><Icon name="play" size={30} /></button>
  <div class="controls">
    <button type="button" class="ctl" data-act="play" aria-label="Přehrát video">
      <span class="i-play"><Icon name="play" size={18} /></span><span class="i-pause"><Icon name="pause" size={18} /></span>
    </button>
    <button type="button" class="ctl ctl-sound" data-act="sound" aria-pressed="false">
      <span class="i-mute"><Icon name="mute" size={18} /></span><span class="i-sound"><Icon name="sound" size={18} /></span>
      <span class="ctl-label">Zapnout zvuk</span>
    </button>
  </div>
</figure>

<style>
  .player { position: relative; margin: 0; border-radius: inherit; overflow: hidden; background: #0b0f0d; isolation: isolate; }
  video { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 9; }
  .vertical video { aspect-ratio: 9 / 16; }
  .controls {
    position: absolute; left: 12px; bottom: 12px; display: flex; gap: 8px; z-index: 2;
    opacity: 0.92; transition: opacity 0.25s;
  }
  .ctl {
    display: inline-flex; align-items: center; gap: 8px; height: 40px; min-width: 40px; padding: 0 11px; border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(10, 14, 12, 0.72); color: #fff; cursor: pointer;
    font: inherit; font-size: 0.88rem; font-weight: 600; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.2s, transform 0.2s var(--ease);
  }
  .ctl:hover { background: rgba(28, 38, 32, 0.9); transform: translateY(-1px); }
  .ctl-sound[aria-pressed='true'] { background: var(--go); color: var(--go-text); border-color: transparent; }
  .i-pause, .i-sound { display: none; }
  .player:global(.playing) .i-play { display: none; }
  .player:global(.playing) .i-pause { display: inline-flex; }
  .ctl-sound[aria-pressed='true'] .i-mute { display: none; }
  .ctl-sound[aria-pressed='true'] .i-sound { display: inline-flex; }
  .i-play, .i-mute { display: inline-flex; }
  .vertical .ctl-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  /* velké „přehrát“ uprostřed, když se video samo nespouští (mobil u ukázek, omezení pohybu, pomalé připojení) */
  .big-play {
    position: absolute; inset: 50% auto auto 50%; translate: -50% -50%; z-index: 2; width: 68px; height: 68px; border-radius: 99px;
    display: none; place-items: center; border: 0; cursor: pointer; color: var(--go-text); background: var(--go);
    box-shadow: 0 10px 30px -6px rgba(94, 224, 138, 0.6); transition: transform 0.2s var(--ease);
  }
  .big-play:hover { transform: scale(1.06); }
  .player:global(.manual:not(.playing)) .big-play { display: grid; }
  /* malé video (mobil): jen ikony, ale dost velké pro palec */
  @media (max-width: 640px) {
    .controls { left: 8px; bottom: 8px; gap: 6px; }
    .ctl { height: 44px; min-width: 44px; padding: 0 10px; border-radius: 12px; justify-content: center; }
    .ctl-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
</style>
