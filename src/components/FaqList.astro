---
import type { Faq } from '../lib/faq.ts';
interface Props { items: Faq[]; openFirst?: number }
const { items, openFirst = 0 } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details id={f.id} data-reveal style={`--i: ${Math.min(i, 4)}`} open={i < openFirst}>
      <summary>{f.q}</summary>
      <div class="answer" set:html={f.a} />
    </details>
  ))}
</div>
