---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { url } from '../lib/site.ts';
import ogSrc from '../../assets/og.jpg';
import f1 from '../../assets/fonts/bricolage-latin.woff2?url';
import f2 from '../../assets/fonts/bricolage-latin-ext.woff2?url';
import f3 from '../../assets/fonts/instrument-latin.woff2?url';
import f4 from '../../assets/fonts/instrument-latin-ext.woff2?url';

interface Props { title?: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ClipFarm` : 'ClipFarm – automatické highlight klipy ze streamů';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site);
---
<!doctype html>
<html lang="cs" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0e1310" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ClipFarm" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ClipFarm: časová osa streamu s oranžovým kopcem chatu a logo ClipFarm – Ty spíš. Farma sklízí. Windows · Linux" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    {[f1, f2, f3, f4].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <Header />
    <main id="obsah" tabindex="-1"><slot /></main>
    <Footer />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
