---
import Base from '../layouts/Base.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import DownloadButton from '../components/DownloadButton.astro';
import DownloadCards from '../components/DownloadCards.astro';
import StreamTimeline from '../components/StreamTimeline.astro';
import FaqList from '../components/FaqList.astro';
import SpamDemo from '../components/SpamDemo.astro';
import ToPc from '../components/ToPc.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { Picture } from 'astro:assets';
import { url, latest } from '../lib/site.ts';
import { HOME_FAQ } from '../lib/faq.ts';

import heroVideo from '../../assets/brag/cs-16x9/brag.mp4?url';
import heroVideoSm from '../../assets/brag/cs-16x9/brag-640.mp4?url';
import heroPoster from '../../assets/brag/cs-16x9/brag.jpg';
import tiktokCs from '../../assets/brag/cs-tiktok-9x16/brag-540.mp4?url';
import tiktokCsPoster from '../../assets/brag/cs-tiktok-9x16/brag.jpg';
import tiktokEn from '../../assets/brag/en-tiktok-9x16/brag-540.mp4?url';
import tiktokEnPoster from '../../assets/brag/en-tiktok-9x16/brag.jpg';
import parody from '../../assets/brag/cs-yc-parody-16x9/brag.mp4?url';
import parodySm from '../../assets/brag/cs-yc-parody-16x9/brag-640.mp4?url';
import parodyPoster from '../../assets/brag/cs-yc-parody-16x9/brag.jpg';
import enMain from '../../assets/brag/en-16x9/brag.mp4?url';
import enMainSm from '../../assets/brag/en-16x9/brag-640.mp4?url';
import enMainPoster from '../../assets/brag/en-16x9/brag.jpg';

import shotKlipy from '../../assets/screenshots/ui-klipy.png';
import shotDetail from '../../assets/screenshots/ui-detail.png';
import shotBezi from '../../assets/screenshots/ui-bezi-web.png';
import shotVarovani from '../../assets/screenshots/ui-varovani.png';
import shotNovinky from '../../assets/screenshots/ui-novinky.png';

import { getImage } from 'astro:assets';
const zoom: Record<string, string> = {};

const shots = [
  { id: 'bezi', tab: 'Nahrávání', img: shotBezi, alt: 'Karta Běží: Nastavení, nahrávání Kicku s odpočtem a logem, hlídání kanálu', text: 'Karta Běží: nahrávání živáku s odpočtem „zbývá 47 min“, hlídání dalšího kanálu a Nastavení (kvalita, limit skóre, klipy na výšku, Spustit, až bude živě). Jména kanálů a řádek logu jsme rozmazali.' },
  { id: 'klipy', tab: 'Galerie klipů', img: shotKlipy, alt: 'Galerie klipů: karty s náhledem a skóre, filtr podle streamera, vybrané klipy ke stažení', text: 'Galerie: skutečné klipy jako karty s náhledem z vrcholu reakce, ★ skóre a délkou. Filtr podle streamera, řazení Nejlepší / Nejnovější, hromadné stažení jako ZIP.' },
  { id: 'detail', tab: 'Detail klipu', img: shotDetail, alt: 'Detail klipu: přehrávač, pás snímků se značkou vrcholu, posuvníky začátku a konce, akce klipu', text: 'Detail klipu s přehrávačem, pásem snímků a značkou vrcholu. Vpravo tabulka, kolik klipů by dal který limit. Od v1.10.01 je místo posuvníků ministudio s časovou osou, hlasitostí a chatem.' },
  { id: 'varovani', tab: 'Aktualizace', img: shotVarovani, alt: 'Varování po spuštění: nová verze ClipFarmu, tlačítka Později a Aktualizovat teď', text: 'Nová verze? Okno to řekne po spuštění. ⬆ Aktualizovat teď, nebo Později – nic se nestáhne bez kliknutí.' },
  { id: 'novinky', tab: 'Co je nového', img: shotNovinky, alt: 'Co je nového: změny od verze, kterou jsi měl, tlačítko OK', text: 'Po aktualizaci okno samo ukáže, co je nového od verze, kterou jsi měl.' },
];
for (const sh of shots) zoom[sh.id] = (await getImage({ src: sh.img, width: 1280, format: 'webp', quality: 82 })).src;
---
<Base description="ClipFarm z dlouhých streamů (YouTube, Kick) automaticky najde nejlepší momenty podle reakcí chatu a hlasitosti a nastříhá z nich klipy – na šířku i na výšku 9:16 pro Shorts, TikTok a Reels. Pro Windows (14 dní zdarma) a Linux.">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><div class="hero-field"></div></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="chip announce enter" href={url(`novinky/#${latest.id}`)}>
          <span class="new">Nové</span> Klipy na výšku s kamerou streamera nahoře <Icon name="arrow" size={16} />
        </a>
        <h1 class="enter" style="--i: 1">
          <span class="kicker">Automatické klipy ze streamů</span>
          <span class="sr">Tři hodiny streamu.</span>
          <span class="clock" aria-hidden="true"><span data-count="10800" data-format="time" data-duration="1600">3:00:00</span></span>
          <span class="hook">Kdo to bude celé&nbsp;koukat?</span>
        </h1>
        <p class="lead enter" style="--i: 2">
          <strong>Nikdo nemusí.</strong> Vlož odkaz na YouTube video nebo kanál na Kicku a ClipFarm podle reakcí chatu
          a hlasitosti sám najde nejlepší momenty a nastříhá z nich klipy – na šířku i na výšku pro Shorts, TikTok a Reels.
        </p>
        <div class="cta-row enter" style="--i: 3">
          <DownloadButton />
          <a class="btn btn-ghost btn-big down" href="#jak-to-funguje">Jak to funguje <Icon name="arrow" size={20} /></a>
        </div>
        <p class="cta-note enter" style="--i: 4"><span>14 dní zdarma na Windows</span><span>žádná kreditka</span><span>YouTube a Kick</span></p>
        <ToPc class="enter" style="--i: 5" />
      </div>

      <div class="hero-media enter" style="--i: 2">
        <div class="media-frame">
          <VideoPlayer id="hero-video" src={heroVideo} mobileSrc={heroVideoSm} poster={heroPoster}
            label="Ukázkové video ClipFarmu"
            description="21sekundové video: časovka 3:00:00 a otázka Kdo to bude celé koukat?, vložení odkazu kick.com/nocni_smena se zaškrtnutým Spustit, až bude živě, nahrávání v noci, časová osa s oranžovým kopcem chatu a značkou vrcholu, galerie klipů se skóre a nakonec logo s textem Ty spíš. Farma sklízí." />
        </div>
        <div class="float f1" aria-hidden="true"><span class="rec-dot"></span> Nahrávání · nocni_smena</div>
        <div class="float f2" aria-hidden="true"><b>pixel_pavla</b> KEKW</div>
        <div class="float f3" aria-hidden="true"><span class="score">★ 6,4</span> klip · 0:34</div>
        <div class="float f4" aria-hidden="true"><span class="ok9">✓</span> Na výšku 9:16</div>
      </div>
    </div>
  </section>

  <!-- JAK TO FUNGUJE -->
  <section class="section" id="jak-to-funguje">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Jak to funguje</span>
        <h2>Odkaz dovnitř, klipy ven.</h2>
        <p class="lead">Pro streamery, kteří chtějí klipy ze svých streamů, i pro klipaře cizích kanálů. Tři kroky – ten prostřední za tebe udělá ClipFarm, klidně v&nbsp;noci, zatímco spíš.</p>
      </div>

      <ol class="step-cards">
        <li class="card step spot" data-reveal>
          <span class="step-n">01</span>
          <div class="mock mock-input" aria-hidden="true">
            <div class="mi-field"><span class="typed">kick.com/nocni_smena</span></div>
            <div class="mi-row">
              <span class="mi-check"><Icon name="check" size={14} /></span> Spustit, až bude živě (Kick)
              <span class="mi-go"><Icon name="play" size={12} /> Spustit</span>
            </div>
          </div>
          <h3>Vlož odkaz</h3>
          <p class="muted">YouTube video, záznam streamu nebo kanál na Kicku. Streamer ještě nevysílá? ClipFarm počká, až naskočí, a nahraje to sám.</p>
        </li>
        <li class="card step spot" data-reveal style="--i: 1">
          <span class="step-n">02</span>
          <div class="mock mock-chart" aria-hidden="true">
            <div class="mc-bars">{[3,4,3,5,4,3,6,9,14,18,15,9,5,4,3,4,3,5,4,3].map((h, i) => <i style={`--h: ${h}; --i: ${i}`} class:list={{ hot: h > 8 }} />)}</div>
            <span class="score mc-score">★ 6,4</span>
          </div>
          <h3>ClipFarm vybere momenty</h3>
          <p class="muted">Každou sekundu obodují reakce chatu a hlasitost. Spam jednoho člověka se nepočítá, KEKW a smích až od tří různých lidí.</p>
        </li>
        <li class="card step spot" data-reveal style="--i: 2">
          <span class="step-n">03</span>
          <div class="mock mock-clips" aria-hidden="true">
            <span class="mcl wide"><span class="score">★ 6,4</span><span class="d">0:34</span></span>
            <span class="mcl tall"><span class="score">★ 5,1</span><span class="d">0:41</span></span>
            <span class="mcl wide b"><span class="score">★ 4,7</span><span class="d">0:27</span></span>
          </div>
          <h3>Hotové klipy</h3>
          <p class="muted">Klip začne na střihu scény nebo v pauze mezi slovy a skončí, až reakce opadne – typicky 20–60 s. Na šířku i na výšku 9:16.</p>
        </li>
      </ol>

      <div class="tl-intro" data-reveal>
        <h3 class="tl-title">Takhle se ze tří hodin stane pár klipů</h3>
        <p class="muted">Pointa je vždycky ten oranžový kopec. Zkus posunout limit skóre: každý moment nad čárou je klip, aspoň dvě minuty od dalšího.</p>
      </div>
      <div data-reveal><StreamTimeline /></div>
      <p class="more-link" data-reveal><a href={url('jak-to-funguje/')}>Jak přesně ClipFarm počítá skóre <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- CO UMÍ -->
  <section class="section features" id="co-umi">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Co umí</span>
        <h2>Celá farma v&nbsp;jednom okně.</h2>
        <p class="lead">Od nahrávání živáku po hotový Short. Bez terminálu a bez střižny.</p>
      </div>

      <div class="bento">
        <article class="card b-watch spot" data-reveal>
          <div class="job" aria-hidden="true">
            <div class="job-head"><span class="rec-dot"></span><b>Nahrávání · nocni_smena</b><span class="job-left">zbývá <span>2:41:07</span></span></div>
            <div class="job-bar"><i></i></div>
            <div class="job-tags"><span class="chip">Hlídá kanál</span><span class="chip">Neuspávat počítač ✓</span></div>
          </div>
          <h3>Hlídá kanál, i když spíš</h3>
          <p class="muted"><strong>Spustit, až bude živě</strong> hlídá kanál na Kicku, i když streamer zrovna nevysílá. Jakmile začne, ClipFarm stream nahraje, nastříhá a hlídá dál na další – klidně víc kanálů naráz. Nahrává se od chvíle spuštění, takže hlídání zapni dopředu. Výpadek internetu nahrávání neukončí a nahrává se i po zavření okna.</p>
        </article>

        <article class="card b-src spot" data-reveal style="--i: 1">
          <div class="src-chips" aria-hidden="true"><span>YouTube</span><span>Kick živě</span><span>720p</span><span>1080p</span><span>1440p</span></div>
          <h3>YouTube i Kick</h3>
          <p class="muted">YouTube video nebo záznam streamu i se záznamem chatu. Živák z Kicku nahrává s chatem do konce streamu, po nastavené době, nebo do <strong>Ukončit a nastříhat</strong>.</p>
        </article>

        <article class="card b-chat spot" data-reveal>
          <h3>Chat, ne spam</h3>
          <p class="muted">Každý člověk se počítá nejvýš jednou za 10 s. Bonus za KEKW, LUL nebo ??? jen když je napíšou aspoň tři různí lidé. Zkus si to:</p>
          <SpamDemo />
        </article>

        <article class="card b-vert spot" data-reveal style="--i: 1">
          <div class="formats" aria-hidden="true">
            <span class="fmt f169"><i></i><em>16:9</em></span>
            <span class="fmt f916"><i></i><em>9:16</em></span>
            <span class="fmt fcam"><i></i><i></i><em>kamera nahoře</em></span>
          </div>
          <h3>Na výšku pro Shorts, TikTok, Reels</h3>
          <p class="muted">9:16 s rozmazaným pozadím, nebo <strong>kamera nahoře</strong>: obličej streamera přes celou šířku, dole celá hra.</p>
        </article>

        <article class="card b-cut spot" data-reveal style="--i: 2">
          <div class="wave" aria-hidden="true">
            {[2,4,7,5,8,6,3,1,1,1,4,9,12,10,13,11,8,6,4,2,1,1,3,5].map((h) => <i style={`--h:${h}`} />)}
            <span class="cut c1"></span><span class="cut c2"></span>
          </div>
          <h3>Klip nezačne uprostřed věty</h3>
          <p class="muted">Začíná na střihu scény nebo v pauze mezi slovy. Ticho delší než 1,5 s (BRB, černá obrazovka) uvnitř klipu nikdy není.</p>
        </article>

        <article class="card b-studio spot" data-reveal>
          <div class="keys" aria-hidden="true"><kbd>Mezerník</kbd><kbd>I</kbd><kbd>O</kbd><kbd>J</kbd><kbd>K</kbd><kbd>L</kbd><kbd>←</kbd><kbd>→</kbd></div>
          <h3>Ministudio na doladění</h3>
          <p class="muted"><strong>Doladit střih</strong> ukáže 5 minut před klipem i po něm: snímky, hlasitost, chat po sekundách a značku vrcholu. Klávesy dělají to, co čekáš od střižny.</p>
        </article>

        <article class="card b-swipe spot" data-reveal style="--i: 1">
          <div class="swipe" aria-hidden="true">
            <span class="sw-card"><span class="score">★ 5,1</span><span class="stamp">NECHAT</span></span>
            <span class="sw-btns"><span class="del">← Smazat</span><span>↓ Nevím</span><span class="keep">→ Nechat</span></span>
          </div>
          <h3>Tinder pro klipy</h3>
          <p class="muted">Po streamu ti ClipFarm ukáže nové klipy jeden po druhém. Šipkou nebo potáhnutím: nechat, smazat, nevím.</p>
        </article>
      </div>

      <ul class="mini-feats" data-reveal>
        <li><Icon name="replay" /><span><strong>Přestříhat bez stahování</strong> s jiným limitem nebo formátem.</span></li>
        <li><Icon name="clock" /><span><strong>Neuspí počítač</strong>, dokud něco běží.</span></li>
        <li><Icon name="download" /><span><strong>Hromadné stažení</strong> klipů jako ZIP s rozumnými názvy.</span></li>
        <li><Icon name="shield" /><span><strong>Aktualizace jedním klikem</strong> – ClipFarm si ověří, že je instalačka pravá.</span></li>
      </ul>
    </div>
  </section>

  <!-- UKÁZKY -->
  <section class="section samples" id="ukazky">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Promo videa</span>
        <h2>ClipFarm za 21 sekund.</h2>
        <p class="lead">Krátká promo videa o ClipFarmu – na výšku jako TikTok, na šířku pro všechno ostatní. Klidně je pošli dál. Zvuk zapneš tlačítkem.</p>
      </div>
      <div class="samples-grid">
        <div class="phones" data-reveal>
          <figure class="phone p1">
            <VideoPlayer vertical src={tiktokCs} poster={tiktokCsPoster} label="TikTok video o ClipFarmu, česky"
              description="Svislé video ve stylu TikTok: streamer jede 6 hodin a ty jsi v práci, ClipFarm to nahraje, spam bot_boba počítá jednou, pointu najde v oranžovém kopci a klipy pak swipeš jako na Tinderu. Na konci 14 dní na zkoušku." />
            <figcaption>Česky</figcaption>
          </figure>
          <figure class="phone p2">
            <VideoPlayer vertical src={tiktokEn} poster={tiktokEnPoster} label="TikTok video o ClipFarmu, anglické titulky"
              description="Stejné svislé video s anglickými titulky, aplikace v něm zůstává česky." />
            <figcaption>Anglicky – pro kámoše ze zahraničí</figcaption>
          </figure>
        </div>
        <div class="wide-sample" data-reveal style="--i: 2">
          <div class="seg" role="tablist" aria-label="Video na šířku">
            <button type="button" role="tab" id="tab-parody" aria-controls="panel-parody" aria-selected="true">Parodie</button>
            <button type="button" role="tab" id="tab-en" aria-controls="panel-en" aria-selected="false" tabindex="-1">Celé video (EN titulky)</button>
          </div>
          <div class="wide-frame">
            <div role="tabpanel" id="panel-parody" aria-labelledby="tab-parody">
              <VideoPlayer src={parody} mobileSrc={parodySm} poster={parodyPoster} label="Parodie na investorský pitch deck"
                description="Smrtelně vážný pitch deck: Problém – streamy jsou dlouhé. Řešení – ClipFarm. Nahrává, i když spíš. Spam jednoho člověka se nepočítá. Pointa je ten oranžový kopec. Obchodní model: 14 dní zkušebně, žádná kreditka. Děkujeme. Otázky?" />
            </div>
            <div role="tabpanel" id="panel-en" aria-labelledby="tab-en" hidden>
              <VideoPlayer src={enMain} mobileSrc={enMainSm} poster={enMainPoster} label="Hlavní video o ClipFarmu s anglickými titulky"
                description="Anglická verze hlavního videa: 3:00:00 – Who's watching all of that? Paste a link, watches the channel even at night, the punchline is the orange hill, vertical clips, You sleep. The farm harvests." />
            </div>
          </div>
          <p class="wide-cap muted small"><strong>Parodie:</strong> ClipFarm jako smrtelně vážná prezentace pro investory. Problém: streamy jsou dlouhé. Řešení: ClipFarm.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SCREENSHOTY -->
  <section class="section" id="screenshoty">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Aplikace</span>
        <h2>Ovládá se z&nbsp;jednoho okna.</h2>
        <p class="lead">Program běží u tebe v počítači – stahování, nahrávání i stříhání. Okno se jen otevře v prohlížeči (Chrome, Edge, Brave, Vivaldi; jinak jako běžná karta), takže nic nenastavuješ a zvenku na něj nikdo nedosáhne.</p>
      </div>
      <div class="shots" data-reveal>
        <div class="shot-tabs" role="tablist" aria-label="Screenshoty aplikace">
          {shots.map((s, i) => (
            <button type="button" role="tab" id={`st-${s.id}`} aria-controls={`sp-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
          ))}
        </div>
        <div class="browser">
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>clipfarm.localhost:8765</span></div>
          {shots.map((s, i) => (
            <div class="shot-panel" role="tabpanel" id={`sp-${s.id}`} aria-labelledby={`st-${s.id}`} hidden={i !== 0}>
              <a class="zoom" href={zoom[s.id]} aria-label={`${s.tab}: otevřít screenshot v plné velikosti`}>
                <Picture src={s.img} alt={s.alt} widths={[640, 960, 1280]} sizes="(max-width: 1240px) 100vw, 1160px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" />
                <span class="zoom-hint" aria-hidden="true">Zvětšit</span>
              </a>
              <p class="shot-text">{s.text}</p>
            </div>
          ))}
        </div>
        <p class="muted small">Skutečné snímky aplikace ze starší verze (v1.03). Co přibylo od té doby, je v <a href={url('novinky/')}>Novinkách</a>.</p>
      </div>
    </div>
  </section>


  <!-- STAŽENÍ -->
  <section class="section" id="stazeni">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Stažení</span>
        <h2>Vyzkoušej ClipFarm.</h2>
        <p class="lead">Na Windows 14 dní celý ClipFarm na zkoušku – žádné ořezané funkce, žádný vodoznak, žádná kreditka. Klipy ze zkušební doby ti zůstanou.</p>
      </div>
      <DownloadCards />
      <p class="not-yet" data-reveal><strong>Zatím neumí:</strong> <span>Twitch</span><span>macOS</span><span>Linux jen pro pozvané</span> <a href={url('napoveda/#omezeni')}>Všechna omezení</a></p>
      <p class="more-link" data-reveal><a href={url('stazeni/')}><span>Postup instalace a systémové požadavky</span> <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap narrow">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Časté otázky</span>
        <h2>Než to stáhneš.</h2>
      </div>
      <FaqList items={HOME_FAQ} />
      <p class="more-link center" data-reveal><a href={url('napoveda/')}>Celá nápověda <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- ZÁVĚR -->
  <section class="section final">
    <div class="wrap">
      <div class="final-card" data-reveal="scale">
        <Logo size={64} class="final-logo" />
        <h2>Ty spíš. <span class="shine">Farma sklízí.</span></h2>
        <p class="lead">Vlož kanál, jdi spát, ráno máš klipy.</p>
        <div class="cta-row center"><DownloadButton /></div>
        <ToPc />
